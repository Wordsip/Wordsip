# Copie ce fichier en .env pour le développement local
# Sur Render, ces variables se configurent dans l'onglet "Environment"

PORT=3000

# Clé API SendGrid (à créer sur sendgrid.com - gratuit jusqu'à 100 emails/jour)
SENDGRID_API_KEY=

# Adresse d'expéditeur des emails automatiques (doit être vérifiée sur SendGrid)
SENDER_EMAIL=noreply@wordsip.example.com

# Adresse de contact affichée sur le site
CONTACT_EMAIL=wordsip@protonmail.com

# Clés API Twitter/X (developer.twitter.com) - pour la publication automatique du tweet quotidien
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
